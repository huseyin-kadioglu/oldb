# Mobile uses the SAME Spring Boot API + PostgreSQL as the web app.
# There is no separate mobile database.
#
# Physical iPhone (same Wi-Fi as the PC running oldb-backend):
#   EXPO_PUBLIC_API_URL=http://192.168.1.102:8080
# Windows browser / emulator on the same PC:
#   EXPO_PUBLIC_API_URL=http://localhost:8080
# Android Emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://192.168.1.102:8080
