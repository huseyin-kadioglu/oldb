# Backend (Railway / Render)
SPRING_PROFILES_ACTIVE=prod
APP_BACKEND_URL=https://your-api.example.com
APP_FRONTEND_URL=https://your-app.example.com
APP_CORS_ORIGINS=https://your-app.example.com
APP_MAIL_FROM=OLDB <noreply@your-domain.com>
SECURITY_JWT_SECRET_KEY=generate-a-long-random-secret
SECURITY_JWT_EXPIRATION_MS=3600000
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DB
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=
APP_UPLOAD_DIR=/data/uploads

# Frontend build
REACT_APP_API_URL=https://your-api.example.com/
