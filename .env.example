# Ortam değişkenleri — sunucuda veya application-local.properties ile ayarlayın
# Yerel: cp oldb-backend/src/main/resources/application-local.properties.example application-local.properties

# Veritabanı (her ortam farklı DB adı kullanır)
DATABASE_URL=jdbc:postgresql://localhost:5432/oldb_local
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword

# JWT (prod/test için güçlü, rastgele değer)
JWT_SECRET_KEY=

# Uygulama URL'leri
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=OLDB <noreply@localhost>

# Spring profili: local | test | prod
SPRING_PROFILES_ACTIVE=local
